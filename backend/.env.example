# RefundShield environment template — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real credentials.

# Razorpay TEST MODE keys (https://dashboard.razorpay.com -> Test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SQLite audit-trail database
DATABASE_URL=sqlite:///./refundshield.db

# Optional overrides
REFUNDSHIELD_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Optional: signing secret for /api/webhooks/razorpay (create in Razorpay dashboard)
RAZORPAY_WEBHOOK_SECRET=whsec_test_xxxxxxxxxxxx
